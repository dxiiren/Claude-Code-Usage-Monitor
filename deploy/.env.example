# Copy to deploy/.env (never commit .env). Placeholder values only.

# ---- required ----
# Sign-in for the web page. The username is compared case-insensitively.
ACCTMGR_ADMIN_USER=Admin
# Use a long random password: the page is reachable from the internet.
# Sign-in is rate limited (5 failures per 15 min per client address, plus a global cap).
ACCTMGR_ADMIN_PASSWORD=change-me-to-a-long-random-password

# The URL people and widgets use, exactly as typed in the browser (scheme + host [+ port]).
# Drives the Host/Origin checks and the Secure cookie (https). Widgets open it for "Manage accounts".
ACCTMGR_PUBLIC_ORIGIN=https://claude.example.com

# ---- optional ----
# Where the port is published on the host. Keep it on loopback behind a tunnel / reverse proxy.
ACCTMGR_PUBLISH=127.0.0.1:47291

# 1 = count sign-in attempts per CF-Connecting-IP. Set ONLY when the container is reachable through
# the Cloudflare tunnel alone (port published on loopback): otherwise a client could fake that
# header to dodge the per-address limit (the global cap still applies). 0 = the socket address.
ACCTMGR_TRUST_PROXY=0

# Seconds between usage polls per account (default 300; accounts are spaced out inside it).
ACCTMGR_POLL_SECONDS=300

# Session signing secret. Empty = generated once and kept in the data volume (/data/session-secret).
ACCTMGR_SESSION_SECRET=

# Pinned Claude Code CLI version baked into the image. Change, then: docker compose up -d --build
CLAUDE_CODE_VERSION=2.1.273
# Codex CLI version baked into the image (Codex accounts).
CODEX_VERSION=0.142.5

TZ=UTC

# ---- HTTPS with your own certificate (optional, LAN servers without a tunnel) ----
# See docker-compose.tls.yml. The app then publishes on loopback only; nginx serves HTTPS.
# COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
# ACCTMGR_TLS_CERT=/path/to/server.crt
# ACCTMGR_TLS_KEY=/path/to/server.key
# ACCTMGR_TLS_PUBLISH=0.0.0.0:1234

# ---- Cloudflare tunnel network (optional) ----
# Attach to the Docker network your cloudflared container uses, then point the tunnel's public
# hostname at http://claude-usage:47291.
# COMPOSE_FILE=docker-compose.yml:docker-compose.tunnel.yml
# ACCTMGR_NETWORK=cloudflared
